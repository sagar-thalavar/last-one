// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String
  role          String   // Student, Employee, Freelancer, Mixed
  studyMode     String?  // e.g., "morning", "evening", "flexible"
  workHours     String?  // e.g., "9-5", "flexible"
  sleepTarget   Int?     // hours per night
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  tasks         Task[]
  sessions      Session[]
  balanceScores BalanceScore[]
  recommendations Recommendation[]
  
  @@map("users")
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  module      String   // College, Work, Life
  title       String
  description String?
  startTime   DateTime?
  endTime     DateTime?
  duration    Int?     // minutes
  priority    String?  // low, medium, high
  tags        String?  // comma-separated
  status      String   @default("planned") // planned, in_progress, complete, cancelled
  location    String?
  dueDate     DateTime?
  isRecurring Boolean  @default(false)
  recurringPattern String? // daily, weekly, monthly
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("tasks")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  taskId    String?
  module    String
  startTime DateTime
  endTime   DateTime?
  duration  Int?     // minutes
  notes     String?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model BalanceScore {
  id            String   @id @default(cuid())
  userId        String
  score         Float    // 0-100
  collegeHours  Float
  workHours     Float
  lifeHours     Float
  sleepHours    Float?
  missedDeadlines Int   @default(0)
  completedTasks  Int
  totalTasks      Int
  stressLevel   Int?    // 1-10 self-reported
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("balance_scores")
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  type        String   // time_shift, sleep, deadline, break, etc.
  title       String
  description String
  action      String?  // actionable step
  priority    String   @default("medium") // low, medium, high
  isRead      Boolean  @default(false)
  isApplied   Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("recommendations")
}

